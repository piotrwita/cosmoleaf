<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Description>Core abstractions, interfaces, and contracts for Kitayec messaging library. Use this package to define message handlers and maintain loose coupling in your domain layer.</Description>
	  <PackageTags>messaging;interfaces;abstractions;contracts;rabbitmq;outbox;deduplication;rossmann;erp</PackageTags>
  </PropertyGroup>
  
   <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.8" />
